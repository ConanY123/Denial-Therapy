# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored and must never be committed.

# Google AI Studio API key (get one at https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# Alternatively, use Application Default Credentials against a GCP project
# (run `gcloud auth application-default login`) and set your project id below.
# GOOGLE_CLOUD_PROJECT=
